# YouTube Data API v3 の APIキー
YOUTUBE_API_KEY=

# 分析対象のチャンネルID（UCxxxxxxxxxx 形式）
CHANNEL_ID=

# OAuth 2.0 クライアントシークレットファイルのパス
CLIENT_SECRETS_FILE=client_secrets.json

# OAuth トークン保存先パス（setup_oauth.py 実行後に生成される）
TOKEN_FILE=token.json

# 登録者数履歴を記録する Google スプレッドシートのID
SPREADSHEET_ID=

# CORS で許可するフロントエンドのオリジン
FRONTEND_URL=http://localhost:3000

# ---- 月次レポート生成 ----
# 解釈・対策セクションを執筆する Gemini API キー（Google AI Studio で無料発行）
GEMINI_API_KEY=
# 使用する Gemini モデル（既定: 無料枠で使える Flash。高品質を要するなら gemini-2.5-pro 等）
GEMINI_MODEL=gemini-2.5-flash
# 月次通知を送る Slack Incoming Webhook URL
SLACK_WEBHOOK_URL=
# レポート Markdown の出力先（リポジトリルートからの相対パス）
REPORT_OUTPUT_DIR=reports
# レポートの GitHub URL 生成に使うリポジトリと対象ブランチ
GITHUB_REPO=Singuralitylabs/youtube-analytics
GITHUB_BRANCH=main
