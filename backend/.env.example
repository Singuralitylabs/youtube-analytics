# YouTube Data API v3 の APIキー
YOUTUBE_API_KEY=

# 分析対象のチャンネルID（UCxxxxxxxxxx 形式）
CHANNEL_ID=

# OAuth 2.0 クライアントシークレットファイルのパス
CLIENT_SECRETS_FILE=client_secrets.json

# OAuth トークン保存先パス（setup_oauth.py 実行後に生成される）
TOKEN_FILE=token.json

# 登録者数履歴を記録する Google スプレッドシートのID
SPREADSHEET_ID=

# CORS で許可するフロントエンドのオリジン
FRONTEND_URL=http://localhost:3000
